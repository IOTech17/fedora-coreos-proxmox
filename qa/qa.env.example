# qa.sh configuration - copy to qa/qa.env (not versioned) and adapt
PVE_HOST=root@proxmox.example.com       # ssh access (key) to the Proxmox node
TEMPLATE_VMID=10000                     # template to clone
REF_VMID=100                            # VM whose cloud-init (user, password hash, ssh keys, dns) is copied
TEST_VMID=19999                         # throw-away VMID (must be free, or an earlier test VM named TEST_NAME)
TEST_NAME=fcos-qa-test                  # name / hostname of the test VM
TEST_IP=192.0.2.199                     # free IPv4 address for the test VM
TEST_IPCONFIG="ip=192.0.2.199/24,gw=192.0.2.1"
#SSH_PORT=59500
#SNIPPET_STORAGE=local
#SNIPPET_DIR=/var/lib/vz/snippets
#BOOT_TIMEOUT=900
#KEEP_BACKUPS=3                         # promote: backups of the production snippets kept on the node
